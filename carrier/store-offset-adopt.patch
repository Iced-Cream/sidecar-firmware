+def _first_fit(taken, bits, cap):
+    """The lowest bit where `bits` bits lie clear of the spans taken and inside cap, or None."""
+    at = 0
+    for a, b in sorted(taken):
+        if at + bits <= a:
+            break
+        at = max(at, b)
+    return at if at + bits <= cap else None
+
