@@ -445,6 +445,14 @@ void CXHCIEndpoint::TransferEvent (u8 uchCompletionCode, u32 nTransferLength)
 					   uchCompletionCode, nTransferLength, m_nURBCount);
 	}
 
+	// circle-xhci-restart: Stopped (26), Stopped - Length Invalid (27) and Stopped - Short Packet (28) come only from
+	// Restart's Stop Endpoint. The TD stays on the ring and runs again when the doorbell restarts the endpoint: its URB
+	// is still pending, so this is not its completion
+	if (uchCompletionCode >= 26 && uchCompletionCode <= 28)
+	{
+		return;
+	}
+
 	CUSBRequest *pURB = m_nURBCount > 0 ? m_pURB[m_nURBHead] : 0;
 	if (!pURB)
 	{
@@ -622,6 +630,25 @@ unsigned CXHCIEndpoint::GetPeriodicIv1 (unsigned *pBusy, char *pList, unsigned n
 	return nCount;
 }
 
+boolean CXHCIEndpoint::Restart (void)
+{
+	if (   !m_bValid
+	    || m_pDevice == 0
+	    || !XHCI_IS_ENDPOINTID (m_uchEndpointID))
+	{
+		return FALSE;
+	}
+
+	assert (m_pXHCIDevice);
+	int nCode = m_pXHCIDevice->GetCommandManager ()->StopEndpoint (m_pDevice->GetSlotID (), m_uchEndpointID);
+
+	// Stopped (or not running, if the command was refused): the doorbell (re)starts it at the TD it stopped on
+	DataSyncBarrier ();
+	m_pMMIO->db_write32 (m_pDevice->GetSlotID (), XHCI_REG_DB_TARGET_EP0 + m_uchEndpointID-1);
+
+	return XHCI_TRB_SUCCESS (nCode);
+}
