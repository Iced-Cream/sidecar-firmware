+
+// ---- circle-gadget-stray: EP0's two directions, armed apart (IRQ level, or IRQs masked) ----------------------------
+//
+// Linux's dwc2 keeps EP0 OUT armed for a SETUP whenever no OUT data stage is armed. Here too: a SETUP the host sends
+// while a request waits for its deferred answer (circle-gadget-mirror), or while the IN data stage of the request
+// before it is still armed, lands in m_SetupBuffer as a normal SETUP done. Before, nothing was armed then, the SETUP
+// went to whatever DOEPDMA0 last pointed at and FinishTransfer() asserted on the SETUP done (the Pi 4 at a live
+// switch to the mirror, 2026-11-06). EP0 OUT is never disabled (the core ignores EPDis on it); EP0 IN is, at every
+// SETUP, so the answer to an older request is never sent as the data of a newer one.
+
+void CDWUSBGadgetEndpoint0::Stray (const char *pWhat)
+{
+	unsigned n = CDWUSBGadgetEndpoint::s_nStray + 1;
+	CDWUSBGadgetEndpoint::s_nStray = n;
+	if ((n & (n - 1)) == 0)
+	{
+		CLogger::Get ()->Write (FromEP0, LogWarning, "%s in state %u: ignored (%u so far)", pWhat, (unsigned) m_State, n);
+	}
+}
+
+void CDWUSBGadgetEndpoint0::OnUSBReset (void)
+{
+	CDWUSBGadgetEndpoint::OnUSBReset ();
+	m_OutSlot = OutNone;
+	m_bInArmed = FALSE;
+}
+
+void CDWUSBGadgetEndpoint0::ArmSetup (void)
+{
+	if (m_OutSlot == OutSetup)
+	{
+		return;
+	}
+	m_OutSlot = OutSetup;
+	m_nOutLength = sizeof (TSetupData);
+	m_pOutBuf = m_SetupBuffer;
+
+	CleanAndInvalidateDataCacheRange ((uintptr) m_SetupBuffer, sizeof m_SetupBuffer);
+
+	CDWHCIRegister OutEPXferSize (DWHCI_DEV_OUT_EP_XFER_SIZ (0), 0);
+	OutEPXferSize.Or (1 << DWHCI_DEV_EP0_XFER_SIZ_SETUP_PKT_CNT__SHIFT);
+	OutEPXferSize.Or (1 << DWHCI_DEV_EP0_XFER_SIZ_PKT_CNT__SHIFT);
+	OutEPXferSize.Or (sizeof (TSetupData) << DWHCI_DEV_EP0_XFER_SIZ_XFER_SIZ__SHIFT);
+	OutEPXferSize.Write ();
+
+	CDWHCIRegister OutEPDMAAddress (DWHCI_DEV_OUT_EP_DMA_ADDR (0), BUS_ADDRESS ((uintptr) m_SetupBuffer));
+	OutEPDMAAddress.Write ();
+
+	CDWHCIRegister OutEPCtrl (DWHCI_DEV_OUT_EP_CTRL (0));
+	OutEPCtrl.Read ();
+	OutEPCtrl.Or (DWHCI_DEV_EP_CTRL_EP_ENABLE);
+	OutEPCtrl.Or (DWHCI_DEV_EP_CTRL_CLEAR_NAK);
+	OutEPCtrl.Write ();
+}
+
+void CDWUSBGadgetEndpoint0::ArmOut (void *pBuffer, size_t nLength)
+{
+	assert (nLength && nLength <= DWHCI_DEV_EP0_XFER_SIZ_XFER_SIZ__MAX);
+	m_OutSlot = OutData;
+	m_nOutLength = nLength;
+	m_pOutBuf = pBuffer;
+
+	CleanAndInvalidateDataCacheRange ((uintptr) pBuffer, nLength);
+
+	unsigned nPacketCount = (nLength + m_nMaxPacketSize - 1) / m_nMaxPacketSize;
+	CDWHCIRegister OutEPXferSize (DWHCI_DEV_OUT_EP_XFER_SIZ (0), 0);
+	OutEPXferSize.Or (nPacketCount << DWHCI_DEV_EP0_XFER_SIZ_PKT_CNT__SHIFT);
+	OutEPXferSize.Or (nLength << DWHCI_DEV_EP0_XFER_SIZ_XFER_SIZ__SHIFT);
+	OutEPXferSize.Write ();
+
+	CDWHCIRegister OutEPDMAAddress (DWHCI_DEV_OUT_EP_DMA_ADDR (0), BUS_ADDRESS ((uintptr) pBuffer));
+	OutEPDMAAddress.Write ();
+
+	CDWHCIRegister OutEPCtrl (DWHCI_DEV_OUT_EP_CTRL (0));
+	OutEPCtrl.Read ();
+	OutEPCtrl.Or (DWHCI_DEV_EP_CTRL_EP_ENABLE);
+	OutEPCtrl.Or (DWHCI_DEV_EP_CTRL_CLEAR_NAK);
+	OutEPCtrl.Write ();
+}
+
+void CDWUSBGadgetEndpoint0::ArmIn (const void *pBuffer, size_t nLength)
+{
+	assert (nLength <= DWHCI_DEV_EP0_XFER_SIZ_XFER_SIZ__MAX);
+	if (m_OutSlot == OutNone)
+	{
+		ArmSetup ();		// the status stage after an IN data stage, or the next SETUP
+	}
+
+	StopIn ();			// (nothing armed normally: one packet at a time)
+	m_bInArmed = TRUE;
+	m_nInLength = nLength;
+
+	if (nLength)
+	{
+		CleanAndInvalidateDataCacheRange ((uintptr) pBuffer, nLength);
+	}
+	else
+	{
+		pBuffer = m_DummyBuffer;
+	}
+
+	unsigned nPacketCount = nLength ? (nLength + m_nMaxPacketSize - 1) / m_nMaxPacketSize : 1;
+	CDWHCIRegister InEPXferSize (DWHCI_DEV_IN_EP_XFER_SIZ (0), 0);
+	InEPXferSize.Or (nPacketCount << DWHCI_DEV_EP0_XFER_SIZ_PKT_CNT__SHIFT);
+	InEPXferSize.Or (nLength << DWHCI_DEV_EP0_XFER_SIZ_XFER_SIZ__SHIFT);
+	InEPXferSize.Write ();
+
+	CDWHCIRegister InEPDMAAddress (DWHCI_DEV_IN_EP_DMA_ADDR (0), BUS_ADDRESS ((uintptr) pBuffer));
+	InEPDMAAddress.Write ();
+
+	CDWHCIRegister InEPCtrl (DWHCI_DEV_IN_EP_CTRL (0));
+	InEPCtrl.Read ();
+	InEPCtrl.And (~DWHCI_DEV_IN_EP_CTRL_NEXT_EP__MASK);
+	InEPCtrl.Or (s_NextEPSeq[0] << DWHCI_DEV_IN_EP_CTRL_NEXT_EP__SHIFT);
+	InEPCtrl.Or (DWHCI_DEV_EP_CTRL_EP_ENABLE);
+	InEPCtrl.Or (DWHCI_DEV_EP_CTRL_CLEAR_NAK);
+	InEPCtrl.Write ();
+}
+
+void CDWUSBGadgetEndpoint0::StopIn (void)
+{
+	CDWHCIRegister InEPCtrl (DWHCI_DEV_IN_EP_CTRL (0));
+	if (InEPCtrl.Read () & DWHCI_DEV_EP_CTRL_EP_ENABLE)
+	{
+		InEPCtrl.And (~DWHCI_DEV_EP_CTRL_CLEAR_NAK);
+		InEPCtrl.Or (DWHCI_DEV_EP_CTRL_SET_NAK | DWHCI_DEV_EP_CTRL_EP_DISABLE);
+		InEPCtrl.Write ();
+
+		CDWHCIRegister InEPInt (DWHCI_DEV_IN_EP_INT (0));
+		for (unsigned i = 0; i < 5000 && !(InEPInt.Read () & DWHCI_DEV_IN_EP_INT_EP_DISABLED); i++)
+		{
+		}
+
+		CDWHCIRegister Reset (DWHCI_CORE_RESET, 0);	// TX FIFO 0 flushed, polled (no 1 ms waits at IRQ level)
+		Reset.Or (DWHCI_CORE_RESET_TX_FIFO_FLUSH);
+		Reset.Write ();
+		for (unsigned i = 0; i < 5000 && (Reset.Read () & DWHCI_CORE_RESET_TX_FIFO_FLUSH); i++)
+		{
+		}
+		CTimer::SimpleusDelay (1);
+	}
+
+	CDWHCIRegister InEPIntAck (DWHCI_DEV_IN_EP_INT (0),   DWHCI_DEV_IN_EP_INT_EP_DISABLED
+							    | DWHCI_DEV_IN_EP_INT_XFER_COMPLETE);
+	InEPIntAck.Write ();
+	m_bInArmed = FALSE;
+}
+
+void CDWUSBGadgetEndpoint0::HandleOutInterrupt (void)
+{
+	CDWHCIRegister OutEPCommonIntMask (DWHCI_DEV_OUT_EP_COMMON_INT_MASK);
+	CDWHCIRegister OutEPInt (DWHCI_DEV_OUT_EP_INT (0));
+	OutEPCommonIntMask.Read ();
+	u32 nInt = OutEPInt.Read () & OutEPCommonIntMask.Get ();
+
+	CDWHCIRegister OutEPIntAck (DWHCI_DEV_OUT_EP_INT (0), nInt);	// all of them at once
+	OutEPIntAck.Write ();
+
+	if (nInt & DWHCI_DEV_OUT_EP_INT_AHB_ERROR)
+	{
+		CLogger::Get ()->Write (FromEP0, LogPanic, "AHB error");
+	}
+
+	if (nInt & DWHCI_DEV_OUT_EP_INT_SETUP_DONE)
+	{
+		const TOutSlot Slot = m_OutSlot;
+		m_OutSlot = OutNone;		// the core disabled EP0 OUT with it
+		StopIn ();			// an older request's IN stage (a late deferred answer) is not sent now
+
+		if (Slot != OutSetup)		// a SETUP into an OUT data stage: its bytes are not where we can find them
+		{
+			Stray ("SETUP during an OUT data stage");
+			if (m_State == StateDeferred)
+			{
+				m_pGadget->OnControlAborted ();
+			}
+			m_State = StateIdle;
+			ArmSetup ();
+
+			return;
+		}
+
+		InvalidateDataCacheRange ((uintptr) m_SetupBuffer, sizeof m_SetupBuffer);
+		OnControlMessage ();
+
+		return;
+	}
+
+	if (nInt & DWHCI_DEV_OUT_EP_INT_XFER_COMPLETE)
+	{
+		CDWHCIRegister OutEPXferSize (DWHCI_DEV_OUT_EP_XFER_SIZ (0));
+		size_t nLeft = (OutEPXferSize.Read () & DWHCI_DEV_EP0_XFER_SIZ_XFER_SIZ__MASK)
+			       >> DWHCI_DEV_EP0_XFER_SIZ_XFER_SIZ__SHIFT;
+		const TOutSlot Slot = m_OutSlot;
+		m_OutSlot = OutNone;
+		size_t nLength = nLeft <= m_nOutLength ? m_nOutLength - nLeft : 0;
+
+		switch (Slot)
+		{
+		case OutData:
+			InvalidateDataCacheRange ((uintptr) m_pOutBuf, m_nOutLength);
+			if (m_State == StateOutDataPhase)
+			{
+				OnTransferComplete (FALSE, nLength);
+			}
+			else
+			{
+				Stray ("OUT data");
+				m_State = StateIdle;
+				ArmSetup ();
+			}
+			break;
+
+		case OutSetup:		// the empty status packet after an IN data stage (or an early one)
+			if (   (m_State == StateOutStatusPhase || m_State == StateInDataPhase)
+			    && nLength == 0)
+			{
+				StopIn ();
+				m_State = StateIdle;
+			}
+			else
+			{
+				Stray ("OUT packet");
+			}
+			ArmSetup ();
+			break;
+
+		default:
+			Stray ("OUT completion with nothing armed");
+			ArmSetup ();
+			break;
+		}
+	}
+}
+
+void CDWUSBGadgetEndpoint0::HandleInInterrupt (void)
+{
+	CDWHCIRegister InEPCommonIntMask (DWHCI_DEV_IN_EP_COMMON_INT_MASK);
+	CDWHCIRegister InEPInt (DWHCI_DEV_IN_EP_INT (0));
+	InEPCommonIntMask.Read ();
+	u32 nInt = InEPInt.Read () & InEPCommonIntMask.Get ();
+
+	CDWHCIRegister InEPIntAck (DWHCI_DEV_IN_EP_INT (0), nInt);
+	InEPIntAck.Write ();
+
+	if (nInt & DWHCI_DEV_IN_EP_INT_AHB_ERROR)
+	{
+		CLogger::Get ()->Write (FromEP0, LogPanic, "AHB error");
+	}
+
+	if (nInt & DWHCI_DEV_IN_EP_INT_XFER_COMPLETE)
+	{
+		if (!m_bInArmed)
+		{
+			Stray ("IN completion with nothing armed");
+
+			return;
+		}
+		m_bInArmed = FALSE;
+
+		CDWHCIRegister InEPXferSize (DWHCI_DEV_IN_EP_XFER_SIZ (0));
+		size_t nLeft = (InEPXferSize.Read () & DWHCI_DEV_EP0_XFER_SIZ_XFER_SIZ__MASK)
+			       >> DWHCI_DEV_EP0_XFER_SIZ_XFER_SIZ__SHIFT;
+		OnTransferComplete (TRUE, nLeft <= m_nInLength ? m_nInLength - nLeft : 0);
+	}
+}
