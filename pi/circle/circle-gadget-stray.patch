+// circle-gadget-stray (IRQ level): a completion for this EP while no transfer is armed on it (TransferUnknown):
+// acknowledged by the caller, ignored, counted; logged the first time and then at powers of two. (EP0 has handlers of
+// its own, dwusbgadgetendpoint0.cpp.)
+volatile unsigned CDWUSBGadgetEndpoint::s_nStray = 0;
+
+void CDWUSBGadgetEndpoint::NoteStray (const char *pWhat)
+{
+	unsigned n = s_nStray + 1;
+	s_nStray = n;
+	if ((n & (n - 1)) == 0)
+	{
+		LOGWARN ("EP%u: %s with no transfer armed: ignored (%u so far)", m_nEP, pWhat, n);
+	}
+}
+
+volatile unsigned CDWUSBGadgetEndpoint::s_nWaitTimeouts = 0;
+
+boolean CDWUSBGadgetEndpoint::WaitFor (u32 nAddress, u32 nMask, boolean bSet, const char *pWhat)
+{
+	CDWHCIRegister Reg (nAddress);
+	for (unsigned i = 0; i < 5000; i++)
+	{
+		if (!!(Reg.Read () & nMask) == !!bSet)
+		{
+			return TRUE;
+		}
+	}
+
+	unsigned n = s_nWaitTimeouts + 1;
+	s_nWaitTimeouts = n;
+	if ((n & (n - 1)) == 0)
+	{
+		LOGWARN ("%s: no answer from the core (%u waits ran out so far)", pWhat, n);
+	}
+
+	return FALSE;
 }
 
+void CDWUSBGadgetEndpoint::DisableIn (unsigned nEP)
+{
+	CDWHCIRegister InEPCtrl (DWHCI_DEV_IN_EP_CTRL (nEP));
+	if (InEPCtrl.Read () & DWHCI_DEV_EP_CTRL_EP_ENABLE)
+	{
+		InEPCtrl.And (~(  DWHCI_DEV_EP_CTRL_CLEAR_NAK | DWHCI_DEV_EP_CTRL_SETDPID_D0
+				| DWHCI_DEV_EP_CTRL_SETDPID_D1));
+		InEPCtrl.Or (DWHCI_DEV_EP_CTRL_SET_NAK);
+		InEPCtrl.Write ();
+		WaitFor (DWHCI_DEV_IN_EP_INT (nEP), DWHCI_DEV_IN_EP_INT_IN_EP_NAK_EFF, TRUE, "IN NAK effective");
+
+		InEPCtrl.Read ();
+		InEPCtrl.And (~(  DWHCI_DEV_EP_CTRL_CLEAR_NAK | DWHCI_DEV_EP_CTRL_SETDPID_D0
+				| DWHCI_DEV_EP_CTRL_SETDPID_D1));
+		InEPCtrl.Or (DWHCI_DEV_EP_CTRL_SET_NAK | DWHCI_DEV_EP_CTRL_EP_DISABLE);
+		InEPCtrl.Write ();
+		WaitFor (DWHCI_DEV_IN_EP_INT (nEP), DWHCI_DEV_IN_EP_INT_EP_DISABLED, TRUE, "IN EP disabled");
+	}
+
+	CDWHCIRegister InEPIntAck (DWHCI_DEV_IN_EP_INT (nEP),   DWHCI_DEV_IN_EP_INT_EP_DISABLED
+							      | DWHCI_DEV_IN_EP_INT_XFER_COMPLETE
+							      | DWHCI_DEV_IN_EP_INT_IN_EP_NAK_EFF);
+	InEPIntAck.Write ();
+
+	// its TX FIFO flushed, polled here: CDWUSBGadget::FlushTxFIFO waits in 1 ms steps (MsDelay), which at IRQ
+	// level stalled core 0's other interrupts for 1 ms (measured: the xHCI host lost Overbridge blocks); the AHB
+	// idle first, as the databook asks
+	WaitFor (DWHCI_CORE_RESET, DWHCI_CORE_RESET_AHB_IDLE, TRUE, "AHB idle");
+	CDWHCIRegister Reset (DWHCI_CORE_RESET, 0);
+	Reset.Or (DWHCI_CORE_RESET_TX_FIFO_FLUSH);
+	Reset.Or (nEP << DWHCI_CORE_RESET_TX_FIFO_NUM__SHIFT);
+	Reset.Write ();
+	WaitFor (DWHCI_CORE_RESET, DWHCI_CORE_RESET_TX_FIFO_FLUSH, FALSE, "TX FIFO flush");
+	CTimer::SimpleusDelay (1);		// 3 PHY clocks
+}
