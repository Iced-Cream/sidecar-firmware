+// circle-gadget-stray (IRQ level): a SETUP came while nothing was armed on EP0 (it waited for a deferred answer, or
+// between stages): its bytes went nowhere we armed, so it is dropped and the host retries it. A deferred request
+// still open is aborted (the host gave up on it with that SETUP), and SETUP reception is armed again.
+void CDWUSBGadgetEndpoint0::OnStraySetup (void)
+{
+	if (m_State == StateDeferred)
+	{
+		m_pGadget->OnControlAborted ();
+	}
+
+	m_State = StateIdle;
+	m_bForwarded = FALSE;
+
+	if (!IsTransferActive ())
+	{
+		BeginTransfer (TransferSetupOut, m_OutBuffer, sizeof (TSetupData));
+	}
+}
