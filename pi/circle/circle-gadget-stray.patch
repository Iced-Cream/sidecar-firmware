+// circle-gadget-stray (IRQ level): a completion for this EP, which has no transfer armed (TransferUnknown): already
+// acknowledged by the caller, ignored; logged the first time and then at powers of two
+volatile unsigned CDWUSBGadgetEndpoint::s_nStray = 0;
+
+void CDWUSBGadgetEndpoint::NoteStray (const char *pWhat)
+{
+	unsigned n = s_nStray + 1;
+	s_nStray = n;
+	if ((n & (n - 1)) == 0)
+	{
+		LOGWARN ("EP%u: %s with no transfer armed: ignored (%u so far)", m_nEP, pWhat, n);
+	}
+}
