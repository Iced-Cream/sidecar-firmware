--- a/include/circle/usb/usbhiddevice.h	2026-10-16 17:09:39
+++ b/include/circle/usb/usbhiddevice.h	2026-10-16 17:10:01
@@ -35,6 +35,25 @@
 
 	boolean ConfigureHID (unsigned nMaxReportSize = 0);
 
+	// circle-hid.patch: an error on the report endpoint halts it in the xHC, and the resubmit from the completion
+	// routine (IRQ) then goes nowhere. The routine now only marks it; Poll() (main loop, not IRQ: it issues xHCI
+	// commands) resets the endpoint and resubmits. Diagnostics for the display's log line.
+	struct THIDStats
+	{
+		unsigned nReports;		// completed requests with data
+		unsigned nErrors;		// completed requests with an error
+		unsigned nLastCode;		// the xHCI completion code of the last transfer error
+		unsigned nXhciErrors;		// the xHC's transfer error events on this endpoint
+		unsigned nResubmits;		// requests submitted again by Poll()
+		unsigned nResets;		// Poll()'s endpoint resets (halted/stopped/error state seen)
+		unsigned nFailed;		// resubmits or resets that failed
+		unsigned nState;		// endpoint state now: 0 off, 1 running, 2 halted, 3 stopped, 4 error
+		unsigned nPending;		// URBs queued on the endpoint
+		boolean  bGaveUp;		// 50 errors in a row: Poll() now retries once a second
+	};
+	void Poll (void);
+	void GetHIDStats (THIDStats *pStats);
+
 protected:
 	// has to be called from Configure() in derived class, when initialization is done
 	boolean StartRequest (void);
@@ -69,6 +88,10 @@
 
 	unsigned m_nErrorCount;		// see CompletionRoutine()
 	unsigned m_nLastErrorTicksHZ;	// see CompletionRoutine()
+	volatile boolean m_bRecover;	// set by the completion routine, cleared by Poll()
+	unsigned m_nLastRecoverTicks, m_nLastCheckTicks;
+	volatile unsigned m_nReports, m_nErrors;
+	unsigned m_nResubmits, m_nResets, m_nFailed;
 };
 
