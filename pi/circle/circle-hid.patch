+
+void CUSBHIDDevice::Poll (void)
+{
+#if RASPPI >= 4
+	if (m_pReportEndpoint == 0 || m_pReportEndpoint->GetXHCIEndpoint () == 0)
+	{
+		return;
+	}
+
+	CXHCIEndpoint *pXHCI = m_pReportEndpoint->GetXHCIEndpoint ();
+	unsigned nNowHZ = CTimer::Get ()->GetTicks ();
+
+	if (!m_bRecover)
+	{
+		// not told by an error: look at the endpoint twice a second (a halt whose event never came)
+		if (nNowHZ - m_nLastCheckTicks < HZ / 2)
+		{
+			return;
+		}
+		m_nLastCheckTicks = nNowHZ;
+
+		unsigned nState = pXHCI->GetEPState ();
+		if (nState == 0 || nState == 1)
+		{
+			return;
+		}
+		m_bRecover = TRUE;
+	}
+
+	if (   m_nErrorCount >= MaxConsecutiveErrors
+	    && nNowHZ - m_nLastRecoverTicks < HZ)
+	{
+		return;						// slowed down, not given up
+	}
+	m_nLastRecoverTicks = nNowHZ;
+
+	if (pXHCI->GetEPState () >= 2)				// halted, stopped or error
+	{
+		m_nResets++;
+		if (!pXHCI->ResetFromHalted ())
+		{
+			m_nFailed++;
+		}
+	}
+
+	if (pXHCI->GetPendingURBs () > 0)
+	{
+		m_bRecover = FALSE;				// a request is queued: nothing to submit
+		return;
+	}
+	if (StartRequest ())
+	{
+		m_nResubmits++;
+		m_bRecover = FALSE;
+	}
+	else
+	{
+		m_nFailed++;					// retried at the next Poll
+	}
+#endif
+}
+
+void CUSBHIDDevice::GetHIDStats (THIDStats *pStats)
+{
+	memset (pStats, 0, sizeof *pStats);
+	pStats->nReports = m_nReports;
+	pStats->nErrors = m_nErrors;
+	pStats->nResubmits = m_nResubmits;
+	pStats->nResets = m_nResets;
+	pStats->nFailed = m_nFailed;
+	pStats->bGaveUp = m_nErrorCount >= MaxConsecutiveErrors;
+#if RASPPI >= 4
+	if (m_pReportEndpoint != 0 && m_pReportEndpoint->GetXHCIEndpoint () != 0)
+	{
+		CXHCIEndpoint *pXHCI = m_pReportEndpoint->GetXHCIEndpoint ();
+		pStats->nLastCode = pXHCI->GetLastErrorCode ();
+		pStats->nXhciErrors = pXHCI->GetErrorCount ();
+		pStats->nState = pXHCI->GetEPState ();
+		pStats->nPending = pXHCI->GetPendingURBs ();
+	}
+#endif
 }
