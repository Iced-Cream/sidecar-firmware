 class CUSBStandardHub : public CUSBFunction
@@ -70,12 +71,20 @@
 	void HandlePortStatusChange (void);
 	friend class CUSBHostController;
 
+	// circle-hub-rearm2.patch: the recovery is asked for from a kernel timer, never from the completion or from
+	// HandlePortStatusChange itself - an endpoint that fails at once again would otherwise keep
+	// CUSBHostController::UpdatePlugAndPlay's loop going for ever (core 0 held, the watchdog)
+	void ScheduleRecovery (void);			// IRQ or task level
+	static void RecoveryTimer (TKernelTimerHandle hTimer, void *pParam, void *pContext);
+
 private:
 	TUSBHubDescriptor *m_pHubDesc;
 
 	CUSBEndpoint *m_pInterruptEndpoint;
 	u8 *m_pStatusChangeBuffer;
-	volatile boolean m_bStatusError;		// circle-hub-rearm.patch: set in the completion (IRQ), handled at task level
+	volatile boolean m_bStatusError;
+	volatile TKernelTimerHandle m_hRecoveryTimer;	// circle-hub-rearm2.patch
+	volatile unsigned m_nConsecErrors;		// circle-hub-rearm2.patch: since the last good completion		// circle-hub-rearm.patch: set in the completion (IRQ), handled at task level
 
 	unsigned m_nPorts;
 	boolean m_bPowerIsOn;
