+	// circle-pcie-probe (obprobe=1, read-only): one config space dword (nWhere & ~3, up to 0xffc) of the root complex
+	// (nBus 0) or of the device at nSlot/nFunc behind it (nBus 1); ~0 when there is no host bridge
+	static u32 ProbeConfig (unsigned nBus, unsigned nSlot, unsigned nFunc, unsigned nWhere);
+	// the offset of a capability (bExtended: an extended one, from 0x100) in that config space; 0 when it has none
+	static unsigned ProbeFindCap (unsigned nBus, unsigned nSlot, unsigned nFunc, unsigned nCapID, boolean bExtended);
