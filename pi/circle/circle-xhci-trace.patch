 static const char From[] = "xhcicmd";
 
+void (*CXHCICommandManager::s_pTraceHook) (unsigned nType, unsigned nSlot) = 0;	// circle-xhci-trace
+static CXHCIMMIOSpace *s_pTraceMMIO = 0;
+
+u32 CXHCICommandManager::ReadMFIndex (void)
+{
+	return s_pTraceMMIO != 0 ? s_pTraceMMIO->rt_read32 (XHCI_REG_RT_MFINDEX) & XHCI_REG_RT_MFINDEX_INDEX__MASK : 0;
+}
+
 CXHCICommandManager::CXHCICommandManager (CXHCIDevice *pXHCIDevice)
 :	m_pXHCIDevice (pXHCIDevice),
 	m_pMMIO (pXHCIDevice->GetMMIOSpace ()),
@@ -38,6 +46,7 @@ CXHCICommandManager::CXHCICommandManager (CXHCIDevice *pXHCIDevice)
 	}
 
 	assert (m_pMMIO != 0);
+	s_pTraceMMIO = m_pMMIO;		// circle-xhci-trace
 	m_pMMIO->op_write64 (XHCI_REG_OP_CRCR,   XHCI_TO_DMA (m_CmdRing.GetFirstTRB ())
 					       | m_CmdRing.GetCycleState ());
 }
@@ -46,6 +55,7 @@ CXHCICommandManager::~CXHCICommandManager (void)
 {
 	assert (m_bCommandCompleted);
 
+	s_pTraceMMIO = 0;		// circle-xhci-trace
 	m_pMMIO = 0;
 	m_pXHCIDevice = 0;
 }
@@ -204,6 +214,12 @@ int CXHCICommandManager::DoCommand (u32 nControl, u32 nParameter1, u32 nParamete
 
 	m_CmdRing.IncrementEnqueue ();
 
+	if (s_pTraceHook != 0)		// circle-xhci-trace
+	{
+		(*s_pTraceHook) ((nControl & XHCI_TRB_CONTROL_TRB_TYPE__MASK) >> XHCI_TRB_CONTROL_TRB_TYPE__SHIFT,
+				 nControl >> 24);
+	}
+
 	DataSyncBarrier ();
 
 	m_pMMIO->db_write32 (XHCI_REG_DB_HOST_CONTROLLER, XHCI_REG_DB_TARGET_HC_COMMAND);
diff --git a/lib/usb/xhciendpoint.cpp b/lib/usb/xhciendpoint.cpp
index 5f4458f..94a0de1 100644
--- a/lib/usb/xhciendpoint.cpp
+++ b/lib/usb/xhciendpoint.cpp
@@ -271,6 +271,10 @@ boolean CXHCIEndpoint::Transfer (CUSBRequest *pURB, unsigned nTimeoutMs)
 	return pURB->GetStatus () ? TRUE : FALSE;
 }
 
+// circle-xhci-trace: the last submit on each slot's endpoints (us; 0: never), for s_pStartHook
+void (*CXHCIEndpoint::s_pStartHook) (unsigned nSlot, unsigned nEndpointID, unsigned nType, unsigned nIdleMs) = 0;
+static unsigned s_nTraceLastUs[XHCI_CONFIG_MAX_SLOTS+1][XHCI_MAX_ENDPOINTS+1];
+
 boolean CXHCIEndpoint::TransferAsync (CUSBRequest *pURB, unsigned nTimeoutMs)
 {
 	assert (pURB != 0);
@@ -293,6 +297,22 @@ boolean CXHCIEndpoint::TransferAsync (CUSBRequest *pURB, unsigned nTimeoutMs)
 	}
 	m_pURB[(m_nURBHead + m_nURBCount) % XHCI_EP_MAX_URBS] = pURB;
 	m_nURBCount++;
+	unsigned nTraceIdleMs = 0;		// circle-xhci-trace: > 0 the endpoint starts after an idle time
+	if (s_pStartHook != 0 && m_pDevice != 0)
+	{
+		unsigned nSlot = m_pDevice->GetSlotID ();
+		if (nSlot <= XHCI_CONFIG_MAX_SLOTS && m_uchEndpointID <= XHCI_MAX_ENDPOINTS)
+		{
+			unsigned nNow = CTimer::GetClockTicks ();
+			unsigned &rLast = s_nTraceLastUs[nSlot][m_uchEndpointID];
+			if (m_nURBCount == 1 && (rLast == 0 || nNow - rLast >= 20000))
+			{
+				unsigned nMs = rLast == 0 ? 0xFFFF : (nNow - rLast) / 1000;
+				nTraceIdleMs = nMs > 0xFFFF ? 0xFFFF : nMs;
+			}
+			rLast = nNow != 0 ? nNow : 1;
+		}
+	}
 	// the lock stays held until the doorbell: an URB resubmitted from a completion routine
 	// (IRQ) must not get its TRB between this URB's FIFO slot and this URB's TRB
 
@@ -417,6 +437,11 @@ boolean CXHCIEndpoint::TransferAsync (CUSBRequest *pURB, unsigned nTimeoutMs)
 
 	m_SpinLock.Release ();
 
+	if (nTraceIdleMs != 0 && s_pStartHook != 0)	// circle-xhci-trace (after the doorbell, the lock released)
+	{
+		(*s_pStartHook) (m_pDevice->GetSlotID (), m_uchEndpointID, m_uchEndpointType, nTraceIdleMs);
+	}
+
 	return TRUE;
 
