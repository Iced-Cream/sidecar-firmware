+// The bus resumed without a reset: back to the state before the suspend, so EP0 hears the host's next SETUP.
+void CDWUSBGadget::HandleWakeUp (void)
+{
+	int nState = m_Wake.Wake ();
+	if (nState == gadgetwake::kNone)
+	{
+		return;
+	}
+
+	LOGTRACE ("USB resume (back to state %u)", (unsigned) nState);
+
+	m_State = (TState) nState;
+
+	for (unsigned i = 0; i <= NumberOfEPs; i++)
+	{
+		if (m_pEP[i])
+		{
+			m_pEP[i]->OnResume ();
+		}
+	}
+}
