+// circle-gadget-unplug (IRQ level): a non-isochronous EP the core disabled. That is what a host that vanishes mid-traffic
+// (the USB-C cable pulled with a bulk or interrupt transfer armed) or a cancel with a transfer armed leaves behind, not
+// an error: Circle had LOGPANIC ("EP%u disabled") here. The interrupt is acknowledged by the caller.
+//  - a completion pending on this EP (XFER_COMPLETE in its INT register, the transfer finished after the handler read
+//    the register: the core clears EPEna on completion): left to the completion path, which runs when the level interrupt
+//    comes again. Dropping the transfer here would lose the completion (a MIDI OUT never armed again, a network
+//    endpoint "busy" for good).
+//  - a transfer still armed and the EP no longer enabled: the core dropped it. It is forgotten (the TX FIFO of an IN EP
+//    flushed) and the function driver told (OnTransferDropped), which arms the EP again.
+//  - the EP enabled again: this was the late interrupt of an earlier cancel, the transfer armed since is left alone.
+// Counted; logged at WARN the first time and then at powers of two, for each EP and kind (OUT disabled, IN disabled,
+// IN timeout) on its own; an IN timeout has its own counter too.
+volatile unsigned CDWUSBGadgetEndpoint::s_nUnplug = 0;
+volatile unsigned CDWUSBGadgetEndpoint::s_nDrop = 0;
+volatile unsigned CDWUSBGadgetEndpoint::s_nTimeout = 0;
+unsigned CDWUSBGadgetEndpoint::s_nUnplugEP[3][16];
+
+void CDWUSBGadgetEndpoint::NoteUnplug (const char *pWhat, boolean bIn, boolean bTimeout)
+{
+	if (bTimeout) s_nTimeout = s_nTimeout + 1;
+	else s_nUnplug = s_nUnplug + 1;
+	unsigned n = ++s_nUnplugEP[bTimeout ? 2 : (bIn ? 1 : 0)][m_nEP & 15];
+	if ((n & (n - 1)) == 0)
+	{
+		LOGWARN ("EP%u: %s, transfer %s (%u so far on this EP)", m_nEP, pWhat, IsTransferActive () ? "armed" : "idle", n);
+	}
+}
+
+void CDWUSBGadgetEndpoint::HandleEPDisabled (boolean bIn)
+{
+	CDWHCIRegister EPCtrl (bIn ? DWHCI_DEV_IN_EP_CTRL (m_nEP) : DWHCI_DEV_OUT_EP_CTRL (m_nEP));
+	CDWHCIRegister EPInt (bIn ? DWHCI_DEV_IN_EP_INT (m_nEP) : DWHCI_DEV_OUT_EP_INT (m_nEP));
+	CDWHCIRegister EPMask (bIn ? DWHCI_DEV_IN_EP_COMMON_INT_MASK : DWHCI_DEV_OUT_EP_COMMON_INT_MASK);
+	const u32 nComplete = bIn ? DWHCI_DEV_IN_EP_INT_XFER_COMPLETE : DWHCI_DEV_OUT_EP_INT_XFER_COMPLETE;
+
+	NoteUnplug (bIn ? "IN disabled" : "OUT disabled", bIn);
+
+	if (EPInt.Read () & EPMask.Read () & nComplete)
+	{
+		return;			// its completion is still to be handled: not a drop
+	}
+
+	boolean bEnabled = (EPCtrl.Read () & DWHCI_DEV_EP_CTRL_EP_ENABLE) != 0;
+	if (IsTransferActive () && !bEnabled)
+	{
+		DisableEndpoint ();	// nothing to wait for (not enabled): acknowledges, flushes the TX FIFO of an IN EP
+		InitTransfer ();
+		s_nDrop = s_nDrop + 1;
+		OnTransferDropped (bIn);
+	}
+}
