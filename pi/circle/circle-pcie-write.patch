+// circle-pcie-write
+boolean CBcmPCIeHostBridge::ProbeConfigWrite (unsigned nBus, unsigned nSlot, unsigned nFunc, unsigned nWhere, u32 nValue)
+{
+	CBcmPCIeHostBridge *p = s_pProbe;
+	if (p == 0 || nBus > 1 || nSlot >= 32 || nFunc >= 8 || nWhere > 0xffc) return FALSE;
+	const uintptr conf = p->pcie_map_conf (nBus, PCI_DEVFN (nSlot, nFunc), nWhere & ~3U);
+	if (conf == 0) return FALSE;
+	write32 (conf, nValue);
+	return TRUE;
+}
