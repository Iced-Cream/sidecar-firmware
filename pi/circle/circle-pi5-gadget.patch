+// BCM2712: the core's power, as Linux's raspberrypi-power driver does it: the old "set power state" tag, device 3 (the
+// USB HCD), bit 0 the state, no wait bit, request length 0. Every firmware answer is 0 here, for every device (measured),
+// so the answer is logged and not looked at.
+void CDWUSBGadget::SetUSBPower (boolean bOn)
+{
+	struct
+	{
+		TPropertyTag	Tag;
+		u32		nId;
+		u32		nState;
+	}
+	PACKED Tag;
+	Tag.Tag.nTagId = PROPTAG_SET_POWER_STATE;
+	Tag.Tag.nValueBufSize = 8;
+	Tag.Tag.nValueLength = 0;
+	Tag.nId = DEVICE_ID_USB_HCD;
+	Tag.nState = bOn ? 1 : 0;
+
+	CBcmPropertyTags Tags;
+	boolean bOK = Tags.GetTags (&Tag, sizeof Tag);
+	LOGNOTE ("Set power %u %s: mailbox %s, length 0x%X, state 0x%X", DEVICE_ID_USB_HCD, bOn ? "on" : "off",
+		 bOK ? "ok" : "failed", Tag.Tag.nValueLength, Tag.nState);
+}
+
+// The FIFO layout of InitCoreDevice() and NumberOfIn/OutEPs are the Pi 4's core's; this one is logged and checked.
+boolean CDWUSBGadget::CheckHardware (void)
+{
+	DumpRegisters ("as the firmware left them");
+
+	CDWHCIRegister VendorId (DWHCI_CORE_VENDOR_ID);
+	CDWHCIRegister HWConfig2 (DWHCI_CORE_HW_CFG2);
+	CDWHCIRegister HWConfig3 (DWHCI_CORE_HW_CFG3);
+	CDWHCIRegister HWConfig4 (DWHCI_CORE_HW_CFG4);
+	u32 nCfg2 = HWConfig2.Read ();
+	u32 nCfg3 = HWConfig3.Read ();
+	u32 nCfg4 = HWConfig4.Read ();
+	unsigned nFIFODepth = DWHCI_CORE_HW_CFG3_DFIFO_DEPTH (nCfg3);
+	unsigned nEPs = ((nCfg2 >> 10) & 0xF) + 1;			// device EPs, EP0 included
+	unsigned nInEPs = DWHCI_CORE_HW_CFG4_NUM_IN_EPS (nCfg4) + 1;	// IN EPs, EP0 included
+
+	LOGNOTE ("Core 0x%08X, HWCFG2 0x%08X, HWCFG3 0x%08X, HWCFG4 0x%08X: FIFO %u words, %u EPs, %u IN EPs%s",
+		 VendorId.Read (), nCfg2, nCfg3, nCfg4, nFIFODepth, nEPs, nInEPs,
+		 nCfg4 & DWHCI_CORE_HW_CFG4_DED_FIFO_EN ? ", dedicated FIFOs" : "");
+
+	if (   nEPs < NumberOfEPs + 1
+	    || nInEPs < NumberOfInEPs + 1
+	    || !(nCfg4 & DWHCI_CORE_HW_CFG4_DED_FIFO_EN))
+	{
+		LOGWARN ("Core differs from the Pi 4's (%u EPs, %u IN EPs, dedicated FIFOs expected)",
+			 NumberOfEPs + 1, NumberOfInEPs + 1);
+	}
+
+	if (nFIFODepth < TOTAL_FIFO_SIZE)	// the layout would run past the FIFO RAM
+	{
+		LOGERR ("FIFO RAM %u words, %u needed", nFIFODepth, TOTAL_FIFO_SIZE);
+
+		return FALSE;
+	}
+
+	return TRUE;
+}
+
+void CDWUSBGadget::DumpRegisters (const char *pWhen)
+{
+	static const u16 Offsets[] =
+	{
+		0x000, 0x004, 0x008, 0x00C, 0x010, 0x014, 0x018, 0x024,		// GOTGCTL GOTGINT GAHBCFG GUSBCFG GRSTCTL GINTSTS GINTMSK GRXFSIZ
+		0x028, 0x02C, 0x030, 0x034, 0x038, 0x03C, 0x040, 0x054,		// GNPTXFSIZ GNPTXSTS GI2CCTL GPVNDCTL GGPIO GUID GSNPSID GLPMCFG
+		0x058, 0x05C, 0x060, 0x100, 0x104, 0x400, 0x440, 0x800,		// GPWRDN GDFIFOCFG GADPCTL HPTXFSIZ DIEPTXF1 HCFG HPRT0 DCFG
+		0x804, 0x808, 0x810, 0x814, 0x818, 0x81C, 0x900, 0xB00,		// DCTL DSTS DIEPMSK DOEPMSK DAINT DAINTMSK DIEPCTL0 DOEPCTL0
+		0xE00,									// PCGCCTL
+	};
+	const unsigned nCount = sizeof Offsets / sizeof Offsets[0];
+	for (unsigned i = 0; i < nCount; i += 8)
+	{
+		CString Line;
+		for (unsigned j = i; j < i + 8 && j < nCount; j++)
+		{
+			CString Item;
+			Item.Format (" %03X=%08X", Offsets[j], read32 (ARM_USB_CORE_BASE + Offsets[j]));
+			Line.Append (Item);
+		}
+		LOGNOTE ("Registers %s:%s", pWhen, (const char *) Line);
+	}
+}
+
+boolean CDWUSBGadget::Reconnect (unsigned nInit)
+{
+	CDWHCIRegister AHBConfig (DWHCI_CORE_AHB_CFG);
+	AHBConfig.Read ();
+	AHBConfig.And (~DWHCI_CORE_AHB_CFG_GLOBALINT_MASK);
+	AHBConfig.Write ();
+
+	CDWHCIRegister DeviceCtrl (DWHCI_DEV_CTRL);
+	DeviceCtrl.Read ();
+	DeviceCtrl.Or (DWHCI_DEV_CTRL_SOFT_DISCONNECT);
+	DeviceCtrl.Write ();
+	CTimer::Get ()->MsDelay (20);
+
+	boolean bOK = InitCorePi5 (nInit);
+
+	m_State = StateSuspended;
+
+	AHBConfig.Read ();
+	AHBConfig.Or (DWHCI_CORE_AHB_CFG_GLOBALINT_MASK);
+	AHBConfig.Write ();
+
+	return bOK;
+}
+
+// The Pi 5's core comes from the boot firmware in host mode (GUSBCFG 20402700: ForceHstMode; DCTL 2, measured), and its
+// firmware sets up the PHY. pi/circle/pi5gadget connected on the first ways it tried (which one: not logged yet), so all stay selectable (usbinit= in
+// cmdline.txt, pi/circle/pi5gadget walks through them):
+//   0  no soft reset, the firmware's GUSBCFG kept, device mode forced
+//   1  soft reset and Circle's PHY fields (the Pi 4's way)
+//   2  soft reset, then the firmware's GUSBCFG back, device mode forced
+//   3  soft reset, UTMI+ 8 bit, HNP/SRP off, turnaround 9, timeout calibration 7, soft-disconnected during the setup
+//   4  as 3, then what Linux's dwc2 does that Circle does not: GOTGINT and GINTSTS cleared, a pulse of
+//      DCTL.PwrOnPrgDone, the global NAKs cleared (the default)
+//   5  as 4, full speed only
+//   6  as 4, after the firmware's power off and on again
+boolean CDWUSBGadget::InitCorePi5 (unsigned nInit)
+{
+	if (nInit == 6)
+	{
+		SetUSBPower (FALSE);
+		CTimer::Get ()->MsDelay (100);
+		SetUSBPower (TRUE);
+		CTimer::Get ()->MsDelay (100);
+	}
+
+	CDWHCIRegister USBConfig (DWHCI_CORE_USB_CFG);
+	u32 nBefore = USBConfig.Read ();
+	if (!m_bBootUSBConfig)
+	{
+		m_nBootUSBConfig = nBefore;
+		m_bBootUSBConfig = TRUE;
+	}
+	USBConfig.And (~(1U << 29));				// ForceHstMode
+	USBConfig.Or (DWHCI_CORE_USB_CFG_FORCE_DEV_MODE);
+	USBConfig.Write ();
+	CTimer::Get ()->MsDelay (25);
+	LOGNOTE ("usbinit=%u: GUSBCFG %08X -> %08X (the firmware's: %08X)", nInit, nBefore, USBConfig.Read (),
+		 m_nBootUSBConfig);
+
+	if (nInit != 0)
+	{
+		if (!Reset ())
+		{
+			LOGERR ("Reset failed");
+			return FALSE;
+		}
+
+		USBConfig.Read ();
+		if (nInit == 2)
+		{
+			USBConfig.Set ((m_nBootUSBConfig & ~(1U << 29)) | DWHCI_CORE_USB_CFG_FORCE_DEV_MODE);
+		}
+		else
+		{
+			USBConfig.And (~(  DWHCI_CORE_USB_CFG_ULPI_UTMI_SEL | DWHCI_CORE_USB_CFG_PHYIF
+					 | DWHCI_CORE_USB_CFG_SRP_CAPABLE | DWHCI_CORE_USB_CFG_HNP_CAPABLE));
+			USBConfig.Or (DWHCI_CORE_USB_CFG_FORCE_DEV_MODE);
+			if (nInit >= 3)
+			{
+				USBConfig.And (~(DWHCI_CORE_USB_CFG_TURNAROUND_TIME__MASK | 7U));
+				USBConfig.Or ((9 << DWHCI_CORE_USB_CFG_TURNAROUND_TIME__SHIFT) | 7U);
+			}
+		}
+		USBConfig.Write ();
+		CTimer::Get ()->MsDelay (25);
+	}
+
+	CDWHCIRegister AHBConfig (DWHCI_CORE_AHB_CFG);
+	AHBConfig.Read ();
+	AHBConfig.Or (DWHCI_CORE_AHB_CFG_DMAENABLE);
+	AHBConfig.Or (DWHCI_CORE_AHB_CFG_WAIT_AXI_WRITES);
+	AHBConfig.And (~DWHCI_CORE_AHB_CFG_MAX_AXI_BURST__MASK);
+	AHBConfig.Write ();
+
+	CDWHCIRegister DeviceCtrl (DWHCI_DEV_CTRL);
+	DeviceCtrl.Read ();
+	DeviceCtrl.Or (DWHCI_DEV_CTRL_SOFT_DISCONNECT);
+	DeviceCtrl.Write ();
+
+	InitCoreDevice ();
+
+	if (nInit >= 4)
+	{
+		if (nInit == 5)
+		{
+			CDWHCIRegister DeviceConfig (DWHCI_DEV_CFG);
+			DeviceConfig.Read ();
+			DeviceConfig.And (~DWHCI_DEV_CFG_DEV_SPEED__MASK);
+			DeviceConfig.Or (DWHCI_DEV_CFG_DEV_SPEED_FS << DWHCI_DEV_CFG_DEV_SPEED__SHIFT);
+			DeviceConfig.Write ();
+		}
+
+		CDWHCIRegister OTGInt (DWHCI_CORE_OTG_INT, ~0U);
+		OTGInt.Write ();
+		CDWHCIRegister IntStatus (DWHCI_CORE_INT_STAT, ~0U);
+		IntStatus.Write ();
+
+		DeviceCtrl.Read ();
+		DeviceCtrl.Or (1 << 11);			// PwrOnPrgDone
+		DeviceCtrl.Write ();
+		CTimer::SimpleusDelay (10);
+		DeviceCtrl.Read ();
+		DeviceCtrl.And (~(1U << 11));
+		DeviceCtrl.Or (DWHCI_DEV_CTRL_CLEAR_GLOBAL_OUT_NAK | (1 << 8));	// and CGNPInNak
+		DeviceCtrl.Write ();
+	}
+
+	CTimer::Get ()->MsDelay (3);			// the host sees the disconnect
+	DeviceCtrl.Read ();
+	DeviceCtrl.And (~DWHCI_DEV_CTRL_SOFT_DISCONNECT);
+	DeviceCtrl.Write ();
+
+	LOGNOTE ("usbinit=%u done: GUSBCFG %08X, connected", nInit, USBConfig.Read ());
+
+	return TRUE;
+}
+
