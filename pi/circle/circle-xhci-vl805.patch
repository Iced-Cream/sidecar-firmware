diff --git a/include/circle/usb/xhciconfig.h b/include/circle/usb/xhciconfig.h
index c35edfa..1f56537 100644
--- a/include/circle/usb/xhciconfig.h
+++ b/include/circle/usb/xhciconfig.h
@@ -60,7 +60,13 @@
 
 #define XHCI_CONFIG_EVENT_RING_SIZE	256
 #define XHCI_CONFIG_CMD_RING_SIZE	64
-#define XHCI_CONFIG_TRANSFER_RING_SIZE	64
+// rytm-pi patch (pi/circle/circle-xhci-vl805.patch): transfer rings of 256 TRBs, as Linux (TRBS_PER_SEGMENT), not 64.
+// With 64 a periodic endpoint's ring wraps through its link TRB every 63 transfers; the VL805 handles link TRBs poorly
+// (Linux XHCI_AVOID_DQ_ON_LINK) and short box OUT ran in k x 984.4/s = k x 1000 x 63/64 steps (2026-11-17)
+#define XHCI_CONFIG_TRANSFER_RING_SIZE	256
+// circle-xhci-vl805: every ring allocated at twice its size and aligned to that size (Linux XHCI_ZHAOXIN_TRB_FETCH,
+// set for the VL805: the controller fetches TRBs past the end of a segment, which must stay in the ring's own memory)
+#define XHCI_CONFIG_RING_ALLOC_FACTOR	2
 
 #define XHCI_CONFIG_IMODI		500		// defines maximum interrupt rate
 
diff --git a/include/circle/usb/xhcisharedmemallocator.h b/include/circle/usb/xhcisharedmemallocator.h
index 97d60f3..f4aee4c 100644
--- a/include/circle/usb/xhcisharedmemallocator.h
+++ b/include/circle/usb/xhcisharedmemallocator.h
@@ -40,6 +40,13 @@
 #define XHCI_BLOCK_ALIGN	64
 #define XHCI_BLOCK_BOUNDARY	0x10000
 
+// rytm-pi patch (pi/circle/circle-xhci-vl805.patch): a second kept class for the 256-TRB rings allocated at twice their
+// size (4 KB ring in an 8 KB block, aligned to 8 KB, as Linux's segment pool with XHCI_ZHAOXIN_TRB_FETCH). Without its
+// own free list every endpoint ring of a device that leaves would be lost (a Rytm restart, a Teensy flash)
+#define XHCI_RING_BLOCK_SIZE		8192
+#define XHCI_RING_BLOCK_ALIGN		8192
+#define XHCI_RING_BLOCK_BOUNDARY	8192
+
 struct TXHCIBlockHeader
 {
 	u32			 nMagic;
@@ -68,6 +75,7 @@ private:
 	uintptr m_nMemEnd;
 
 	TXHCIBlockHeader *m_pFreeList;
+	TXHCIBlockHeader *m_pRingFreeList;	// circle-xhci-vl805
 };
 
 #endif
