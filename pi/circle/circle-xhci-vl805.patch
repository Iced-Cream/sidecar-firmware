+	CLogger::Get ()->Write (From, LogNotice, "circle-xhci-vl805: rings %u TRB (x%u alloc), interrupt avg TRB = 16 (rings only)",
+				XHCI_CONFIG_TRANSFER_RING_SIZE, XHCI_CONFIG_RING_ALLOC_FACTOR);
 #ifdef XHCI_DEBUG
 	CLogger::Get ()->Write (From, LogDebug, "%u slots, %u ports, %u scratchpad bufs",
 				nMaxSlots, nMaxPorts, nMaxScratchpadBufs);
diff --git a/lib/usb/xhciendpoint.cpp b/lib/usb/xhciendpoint.cpp
index 206e179..7676dbc 100644
--- a/lib/usb/xhciendpoint.cpp
+++ b/lib/usb/xhciendpoint.cpp
@@ -492,10 +492,24 @@ boolean CXHCIEndpoint::ResetFromHalted (void)
 	}
 
 	assert (m_pTransferRing);
+	// circle-xhci-vl805: the new dequeue is the enqueue TRB with the ring's own cycle state (never the context's
+	// written-back DCS, which the VL805 gets wrong: Linux XHCI_EP_CTX_BROKEN_DCS). The enqueue index never rests on the
+	// link TRB (IncrementEnqueue wraps past it), so the dequeue is never set on one (Linux XHCI_AVOID_DQ_ON_LINK);
+	// both checked here rather than assumed
+	TXHCITRB *pDequeueTRB = m_pTransferRing->GetEnqueueTRB ();
+	if (   pDequeueTRB == 0
+	    || pDequeueTRB == &m_pTransferRing->GetFirstTRB ()[m_pTransferRing->GetTRBCount () - 1])
+	{
+		CLogger::Get ()->Write (From, LogWarning, "EP %u: no valid dequeue TRB after reset",
+					(unsigned) m_uchEndpointID);
+
+		return FALSE;
+	}
+
 	return m_pXHCIDevice->GetCommandManager ()->SetTRDequeuePointer (
 								m_pDevice->GetSlotID (),
 								m_uchEndpointID,
-								m_pTransferRing->GetEnqueueTRB (),
+								pDequeueTRB,
 								!!m_pTransferRing->GetCycleState ());
 }
 
@@ -657,6 +671,8 @@ TXHCIInputContext *CXHCIEndpoint::GetInputContextConfigureEndpoint (void)
 	case XHCI_EP_CONTEXT_EP_TYPE_INTERRUPT_OUT:
 	case XHCI_EP_CONTEXT_EP_TYPE_INTERRUPT_IN:
 		pEPContext->Interval = m_uchInterval;
+		// circle-xhci-vl805 (rings only, 2026-11-18): kept at 16 as stock Circle. The real size (as Linux) ran in XV1
+		// (KB T421) together with the rings and both boxes' IN collapsed; this variant tests the rings alone
 		pEPContext->AverageTRBLength = 16;	// best guess
 		pEPContext->MaxESITPayload = m_usMaxPacketSize;
 		break;
