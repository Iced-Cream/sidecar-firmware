@@ -38,8 +40,21 @@ CXHCIRing::CXHCIRing (TXHCIRingType Type, unsigned nTRBCount, CXHCIDevice *pAllo
 	assert (m_nTRBCount % 4 == 0);
 
 	assert (m_pAllocator != 0);
-	m_pFirstTRB = (TXHCITRB *) m_pAllocator->AllocateSharedMem (m_nTRBCount * sizeof (TXHCITRB),
-								    64, 0x10000);
+	// circle-xhci-vl805: twice the ring's size, so a TRB fetch past its end stays in its own memory (Linux
+	// XHCI_ZHAOXIN_TRB_FETCH). Up to 2 KB this is the allocator's kept 2 KB class, as before; the 256-TRB rings take
+	// its kept 8 KB class (8 KB aligned, as Linux's segment pool), the only other size that is freed and reused
+	size_t nBytes = XHCI_CONFIG_RING_ALLOC_FACTOR * m_nTRBCount * sizeof (TXHCITRB);
+	if (nBytes <= XHCI_BLOCK_SIZE)
+	{
+		m_pFirstTRB = (TXHCITRB *) m_pAllocator->AllocateSharedMem (nBytes, 64, 0x10000);
+	}
+	else
+	{
+		assert (nBytes == XHCI_RING_BLOCK_SIZE);
+		m_pFirstTRB = (TXHCITRB *) m_pAllocator->AllocateSharedMem (XHCI_RING_BLOCK_SIZE,
+									    XHCI_RING_BLOCK_ALIGN,
+									    XHCI_RING_BLOCK_BOUNDARY);
+	}
 	if (m_pFirstTRB == 0)
 	{
 		return;
