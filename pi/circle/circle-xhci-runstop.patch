 	unsigned ProbeSlotID (void) const;
 	unsigned ProbeEndpointID (void) const	{ return m_uchEndpointID; }
 
+	// circle-xhci-runstop (obstallrs=1, an experiment; not read-only): one Run/Stop cycle of the whole controller:
+	// clear USBCMD R/S, wait for USBSTS HCHalted (20 ms at most), set R/S again, wait for HCHalted to clear (20 ms at
+	// most). Busy-waits; main loop only. pInfo (7 words): MFINDEX before, us to halt, MFINDEX halted, us to run,
+	// MFINDEX after, USBSTS after, USBCMD after. 0 done; 1 no controller; 2 did not halt (R/S set again anyway);
+	// 3 did not run again.
+	static int ProbeRunStop (u32 *pInfo);
+	// ring this endpoint's doorbell (its queued TRBs are looked at again; harmless on a running endpoint)
+	void ProbeDoorbell (void);
+
 #ifndef NDEBUG
 	void DumpStatus (void);
 #endif
