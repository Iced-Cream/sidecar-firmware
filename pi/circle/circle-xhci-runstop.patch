+
+// circle-xhci-runstop
+int CXHCIEndpoint::ProbeRunStop (u32 *pInfo)
+{
+	CXHCIMMIOSpace *p = s_pProbeMMIO;
+	for (unsigned i = 0; i < 7; i++) pInfo[i] = 0;
+	if (p == 0) return 1;
+	CTimer *pTimer = CTimer::Get ();
+	pInfo[0] = p->rt_read32 (XHCI_REG_RT_MFINDEX) & XHCI_REG_RT_MFINDEX_INDEX__MASK;
+	unsigned t0 = pTimer->GetClockTicks ();
+	p->op_write32 (XHCI_REG_OP_USBCMD, p->op_read32 (XHCI_REG_OP_USBCMD) & ~XHCI_REG_OP_USBCMD_RUN_STOP);
+	const boolean bHalted = p->op_wait32 (XHCI_REG_OP_USBSTS, XHCI_REG_OP_USBSTS_HCH, XHCI_REG_OP_USBSTS_HCH, 20000);
+	unsigned t1 = pTimer->GetClockTicks ();
+	pInfo[1] = (t1 - t0) / (CLOCKHZ / 1000000);
+	pInfo[2] = p->rt_read32 (XHCI_REG_RT_MFINDEX) & XHCI_REG_RT_MFINDEX_INDEX__MASK;
+	p->op_write32 (XHCI_REG_OP_USBCMD, p->op_read32 (XHCI_REG_OP_USBCMD) | XHCI_REG_OP_USBCMD_RUN_STOP);
+	const boolean bRunning = p->op_wait32 (XHCI_REG_OP_USBSTS, XHCI_REG_OP_USBSTS_HCH, 0, 20000);
+	unsigned t2 = pTimer->GetClockTicks ();
+	pInfo[3] = (t2 - t1) / (CLOCKHZ / 1000000);
+	pInfo[4] = p->rt_read32 (XHCI_REG_RT_MFINDEX) & XHCI_REG_RT_MFINDEX_INDEX__MASK;
+	pInfo[5] = p->op_read32 (XHCI_REG_OP_USBSTS);
+	pInfo[6] = p->op_read32 (XHCI_REG_OP_USBCMD);
+	return !bHalted ? 2 : !bRunning ? 3 : 0;
+}
+
+void CXHCIEndpoint::ProbeDoorbell (void)
+{
+	if (!m_bValid || m_pDevice == 0 || !XHCI_IS_ENDPOINTID (m_uchEndpointID) || m_pDevice->GetSlotID () == 0) return;
+	DataSyncBarrier ();
+	m_pMMIO->db_write32 (m_pDevice->GetSlotID (), XHCI_REG_DB_TARGET_EP0 + m_uchEndpointID-1);
+}
