+unsigned CXHCIEndpoint::GetEPState (void)
+{
+	if (!m_bValid || m_pDevice == 0 || !XHCI_IS_ENDPOINTID (m_uchEndpointID))
+	{
+		return 0;
+	}
+
+	DataMemBarrier ();
+	TXHCIDeviceContext *pContext = m_pDevice->GetDeviceContext ();	// coherent shared memory
+
+	return ((volatile TXHCIEndpointContext *) &pContext->Endpoint[m_uchEndpointID-1])->EPState;
+}
