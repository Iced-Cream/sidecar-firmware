 	m_pTransferRing = new CXHCIRing (XHCIRingTypeTransfer,
 					 XHCI_CONFIG_TRANSFER_RING_SIZE, pXHCIDevice);
 	if (   m_pTransferRing == 0
@@ -87,6 +92,7 @@ CXHCIEndpoint::CXHCIEndpoint (CXHCIUSBDevice *pDevice, const TUSBEndpointDescrip
 	m_bTransferCompleted (TRUE),
 	m_pInputContextBuffer (0)
 {
+	if (s_pProbeMMIO == 0) s_pProbeMMIO = m_pMMIO;		// circle-xhci-probe
 	m_pTransferRing = new CXHCIRing (XHCIRingTypeTransfer,
 					 XHCI_CONFIG_TRANSFER_RING_SIZE, pXHCIDevice);
 	if (   m_pTransferRing == 0
@@ -881,3 +887,46 @@ u8 CXHCIEndpoint::ConvertInterval (u8 uchInterval, TUSBSpeed Speed)
 
 	return i;
 }
+
+// circle-xhci-probe
+u32 CXHCIEndpoint::ProbeMFIndex (void)
+{
+	CXHCIMMIOSpace *p = s_pProbeMMIO;
+	return p == 0 ? ~0U : p->rt_read32 (XHCI_REG_RT_MFINDEX) & XHCI_REG_RT_MFINDEX_INDEX__MASK;
+}
+
+u32 CXHCIEndpoint::ProbeReg (unsigned nWhich)
+{
+	CXHCIMMIOSpace *p = s_pProbeMMIO;
+	if (p == 0) return ~0U;
+	switch (nWhich)
+	{
+	case 0:	return p->op_read32 (XHCI_REG_OP_USBSTS);
+	case 1:	return p->rt_read32 (0, XHCI_REG_RT_IR_IMAN);
+	case 2:	return (u32) p->rt_read64 (0, XHCI_REG_RT_IR_ERDP_LO);
+	case 3:	return p->op_read32 (XHCI_REG_OP_CRCR);
+	case 4:	return p->pt_read32 (0, XHCI_REG_OP_PORTS_PORTSC);
+	case 5:	return p->rt_read32 (XHCI_REG_RT_MFINDEX);
+	default: return ~0U;
+	}
+}
+
+unsigned CXHCIEndpoint::ProbeSlotID (void) const
+{
+	return m_pDevice == 0 ? 0 : m_pDevice->GetSlotID ();
+}
+
+unsigned CXHCIEndpoint::ProbeContext (u32 *pDW, unsigned nMax)
+{
+	if (!m_bValid || m_pDevice == 0 || !XHCI_IS_ENDPOINTID (m_uchEndpointID) || m_pDevice->GetSlotID () == 0)
+	{
+		return 0;
+	}
+	DataMemBarrier ();
+	TXHCIDeviceContext *pContext = m_pDevice->GetDeviceContext ();	// coherent shared memory
+	const volatile u32 *pSrc = (const volatile u32 *) &pContext->Endpoint[m_uchEndpointID-1];
+	unsigned n = XHCI_CONTEXT_SIZE / 4;
+	if (n > nMax) n = nMax;
+	for (unsigned i = 0; i < n; i++) pDW[i] = pSrc[i];
+	return n;
+}
