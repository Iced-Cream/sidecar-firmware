+// circle-xhci-probe: the controller's registers, for ProbeMFIndex / ProbeReg (set by the first endpoint made: EP0 of the
+// first device; one xHC on the Pi 4)
+static CXHCIMMIOSpace *s_pProbeMMIO;
+
 CXHCIEndpoint::CXHCIEndpoint (CXHCIUSBDevice *pDevice, CXHCIDevice *pXHCIDevice)
 :	m_pDevice (pDevice),
 	m_pXHCIDevice (pXHCIDevice),
@@ -57,6 +61,7 @@ CXHCIEndpoint::CXHCIEndpoint (CXHCIUSBDevice *pDevice, CXHCIDevice *pXHCIDevice)
 	m_bTransferCompleted (TRUE),
