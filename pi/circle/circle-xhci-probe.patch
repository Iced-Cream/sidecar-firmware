diff -ruN a/include/circle/usb/xhciendpoint.h b/include/circle/usb/xhciendpoint.h
--- a/include/circle/usb/xhciendpoint.h
+++ b/include/circle/usb/xhciendpoint.h
@@ -80,6 +80,19 @@ public:
 	// The VL805 on the Pi 4 has starved one of them whenever 6 or more were busy (diagnosis-periodic-starvation.md).
 	static unsigned GetPeriodicIv1 (unsigned *pBusy = 0, char *pList = 0, unsigned nListSize = 0);
 
+	// circle-xhci-probe: reads for the VL805 periodic-stall probe (pi/engine/vl805_probe.h). Reads only: nothing here
+	// changes the controller. ProbeMFIndex: the microframe index (MFINDEX, 14 bits, 125 us each, wraps every 2.048 s);
+	// ~0 before any controller is up. Any level (one PCIe read).
+	static u32 ProbeMFIndex (void);
+	// 0 USBSTS, 1 IMAN (interrupter 0), 2 ERDP low, 3 CRCR low, 4 PORTSC of root port 1, 5 MFINDEX; ~0 without a controller
+	static u32 ProbeReg (unsigned nWhich);
+	// this endpoint's output context as the controller last wrote it, raw (up to nMax dwords: 8 with 32-byte contexts,
+	// 16 with 64-byte ones); 0 when it has no slot. Its xHC-reserved dwords (5-7 and up) are where a controller may keep
+	// its own scheduling state.
+	unsigned ProbeContext (u32 *pDW, unsigned nMax);
+	unsigned ProbeSlotID (void) const;
+	unsigned ProbeEndpointID (void) const	{ return m_uchEndpointID; }
+
 #ifndef NDEBUG
 	void DumpStatus (void);
 #endif
