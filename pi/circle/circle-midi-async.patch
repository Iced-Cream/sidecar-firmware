+// circle-midi-async.patch: one OUT URB at a time, never waiting: a device that does not take it holds that URB, nothing else
+boolean CUSBMIDIHostDevice::SendAsyncHandler (const u8 *pData, unsigned nLength, void *pParam)
+{
+	CUSBMIDIHostDevice *pThis = static_cast<CUSBMIDIHostDevice *> (pParam);
+	assert (pThis);
+
+	if (   pThis->m_pEndpointOut == 0 || pThis->m_bTxBusy
+	    || nLength == 0 || nLength > TxBufferSize || (nLength & 3) != 0)
+	{
+		return FALSE;
+	}
+
+	memcpy (pThis->m_pTxBuffer, pData, nLength);
+
+	CUSBRequest *pURB = new CUSBRequest (pThis->m_pEndpointOut, pThis->m_pTxBuffer, nLength);
+	assert (pURB != 0);
+	pURB->SetCompletionRoutine (TxCompletionStub, 0, pThis);
+
+	pThis->m_bTxBusy = TRUE;
+	if (!pThis->GetHost ()->SubmitAsyncRequest (pURB))
+	{
+		pThis->m_bTxBusy = FALSE;
+		delete pURB;
+
+		return FALSE;
+	}
+
+	return TRUE;
+}
+
+unsigned CUSBMIDIHostDevice::SendStateHandler (void *pParam)
+{
+	CUSBMIDIHostDevice *pThis = static_cast<CUSBMIDIHostDevice *> (pParam);
+	assert (pThis);
+
+	if (pThis->m_bTxBusy)
+	{
+		return 1;
+	}
+	if (pThis->m_bTxFailed)
+	{
+		pThis->m_bTxFailed = FALSE;
+
+		return 2;
+	}
+
+	return 0;
+}
+
+void CUSBMIDIHostDevice::TxCompletionStub (CUSBRequest *pURB, void *pParam, void *pContext)
+{
+	CUSBMIDIHostDevice *pThis = (CUSBMIDIHostDevice *) pContext;
+	assert (pThis != 0);
+
+	pThis->m_bTxFailed = pURB->GetStatus () == 0;
+	delete pURB;
+	pThis->m_bTxBusy = FALSE;
 }
 
 boolean CUSBMIDIHostDevice::StartRequest (void)
