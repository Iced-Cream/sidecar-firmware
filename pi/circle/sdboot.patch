+//------------------------------------------------------------------------
+// sdboot (rytm-teensy pi/circle/sdboot.patch): the BCM watchdog (65536 ticks a second, at most 0xFFFFF: 16 s)
+#define PM_RSTC         (PBASE+0x0010001C)
+#define PM_WDOG         (PBASE+0x00100024)
+#define PM_PASSWD       0x5A000000
+void wdog_start ( unsigned int ticks )
+{
+    PUT32(PM_WDOG, PM_PASSWD | (ticks & 0xFFFFF));
+    PUT32(PM_RSTC, PM_PASSWD | (GET32(PM_RSTC) & ~0x30) | 0x20);
+}
+void wdog_stop ( void )
+{
+    PUT32(PM_RSTC, PM_PASSWD | 0x102);
+}
