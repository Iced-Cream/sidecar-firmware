+//-------------------------------------------------------------------------
+// sdboot (rytm-teensy pi/circle/sdboot.patch): the serial bootloader as the SD card's kernel that also boots the
+// engine from the card. config.txt's "initramfs engine.img 0x02000000" has the firmware load engine.img (a
+// 32-byte header + the raw kernel8-rpi4.img, pi/circle/sdboot.py) next to this bootloader. After IHEX-F the
+// bootloader waits SDB_WINDOW_US for a byte; with none it copies the engine to 0x80000 and starts it. Any byte
+// (flash.sh's hold bytes, 0x80, sent from the reboot on) keeps it the serial bootloader, also across the flasher's
+// 'R'. An upload that stalls (no byte for SDB_IDLE_US inside the transfer, SDB_READY_US before its first record)
+// restarts with the window, so the engine boots again. No globals: the code is copied to 0x800000 and its GOT
+// is not relocated. AArch64 only (ldp/stp; build-sdboot.sh builds kernel8-rpi4.img).
+#define SDB_ADDR	0x02000000UL
+#define SDB_MAGIC0	0x52434453U	// "SDCR"
+#define SDB_MAGIC1	0x31474E45U	// "ENG1"
+#define SDB_HDRWORDS	8
+#define SDB_DEST	0x80000UL
+#define SDB_MAXLEN	(0x800000UL - 0x80000UL)	// below the relocated bootloader
+#define SDB_WINDOW_US	1000000
+#define SDB_IDLE_US	5000000
+#define SDB_READY_US	5000000	// the flasher sends at once on IHEX (measured: flashy within ms)
+#define SDB_TIMEOUT	0x100
+#define SDB_WDOG	(15 * 65536)	// armed at the start: a hang before the flasher or the engine resets the Pi
+
+static unsigned int recv_timeout (unsigned int us)
+{
+    if (uart_check())			// the fast path: a byte every 10.9 us at 921600 baud
+        return uart_recv();
+    unsigned int start = timer_tick();
+    while (!uart_check())
+    {
+        if (timer_tick() - start >= us)
+            return SDB_TIMEOUT;
+    }
+    return uart_recv();
+}
+
+// The instruction cache (MMU off: instruction fetches only): the byte loop runs from the cache, not from DRAM.
+// Off again (and invalidated) before the engine starts, so it starts as from the stock bootloader.
+#if AARCH == 64
+static unsigned long el_of (void)
+{
+    unsigned long el;
+    asm volatile ("mrs %0, CurrentEL" : "=r" (el));
+    return (el >> 2) & 3;
+}
+static void icache (int on)
+{
+    unsigned long v;
+    asm volatile ("ic iallu; dsb sy; isb" ::: "memory");
+    if (el_of() == 2)
+    {
+        asm volatile ("mrs %0, sctlr_el2" : "=r" (v));
+        v = on ? v | (1UL << 12) : v & ~(1UL << 12);
+        asm volatile ("msr sctlr_el2, %0; isb" :: "r" (v) : "memory");
+    }
+    else if (el_of() == 1)
+    {
+        asm volatile ("mrs %0, sctlr_el1" : "=r" (v));
+        v = on ? v | (1UL << 12) : v & ~(1UL << 12);
+        asm volatile ("msr sctlr_el1, %0; isb" :: "r" (v) : "memory");
+    }
+    asm volatile ("ic iallu; dsb sy; isb" ::: "memory");
+}
+#else
+static void icache (int on) { (void) on; }
+#endif
+
+static void send_dec (unsigned int n)
+{
+    char b[12]; int i = 0;
+    do { b[i++] = '0' + n % 10; n /= 10; } while (n);
+    while (i) uart_send(b[--i]);
+}
+
+// The engine's length in bytes if a valid image is at SDB_ADDR, else 0 (the words' Fletcher-style sums).
+static unsigned int sdb_check (void)
+{
+    volatile unsigned int *h = (volatile unsigned int *) SDB_ADDR;
+    if (h[0] != SDB_MAGIC0 || h[1] != SDB_MAGIC1) return 0;
+    unsigned int len = h[2];
+    if (len == 0 || len > SDB_MAXLEN || (len & 3)) return 0;
+    const volatile unsigned long *p = (const volatile unsigned long *) (h + SDB_HDRWORDS);
+    unsigned int s1 = 0, s2 = 0, i;
+    for (i = 0; i < len / 16; i++)	// 16 bytes a load (as in sdb_boot), the sums still over 4-byte words
+    {
+        unsigned long a, b;
+        asm volatile ("ldp %0, %1, [%2]" : "=r" (a), "=r" (b) : "r" (p + 2 * i) : "memory");
+        s1 += (unsigned int) a; s2 += s1; s1 += (unsigned int) (a >> 32); s2 += s1;
+        s1 += (unsigned int) b; s2 += s1; s1 += (unsigned int) (b >> 32); s2 += s1;
+    }
+    for (i *= 4; i < len / 4; i++) { s1 += ((volatile unsigned int *) p)[i]; s2 += s1; }
+    if (s1 != h[3] || s2 != h[4]) return 0;
+    return len;
+}
 
+static void sdb_boot (unsigned int len)
+{
+    uart_send_str("sdboot: starting the engine\r\n");
+    uart_flush();
+    wdog_stop();	// the engine runs its own (kernel.cpp)
+    volatile unsigned int *h = (volatile unsigned int *) SDB_ADDR;
+    // 16 bytes a transfer: with the MMU off every access is to Device memory and waits for its completion
+    // (4-byte words: about 3 s for 1.5 MB, measured)
+    const volatile unsigned long *p = (const volatile unsigned long *) (h + SDB_HDRWORDS);
+    volatile unsigned long *q = (volatile unsigned long *) SDB_DEST;
+    unsigned int i, n = (len + 15) / 16;
+    for (i = 0; i < n; i++)
+    {
+        unsigned long a, b;
+        asm volatile ("ldp %0, %1, [%2]" : "=r" (a), "=r" (b) : "r" (p + 2 * i) : "memory");
+        asm volatile ("stp %0, %1, [%2]" :: "r" (a), "r" (b), "r" (q + 2 * i) : "memory");
+    }
+    h[0] = 0;		// a later boot sees only what the firmware loads then
+    uart_send_str("sdboot: copied, jumping to 0x80000\r\n");
+    uart_flush();
+    icache(0);
+    BRANCHTO(SDB_DEST);
+}
+
