+// An isochronous IN (OUT) transfer was armed, but not done in the (micro)frame, which ends now: each such EP is
+// re-armed for the other frame parity (CDWUSBGadgetEndpoint::HandleIncompleteIso).
+void CDWUSBGadget::HandleIncompleteIso (boolean bIn)
+{
+	unsigned nFrame = CDWUSBGadgetEndpoint::GetFrameNumber ();
+
+	if (m_State == StateConfigured)
+	{
+		for (unsigned i = 1; i <= NumberOfEPs; i++)
+		{
+			if (   m_pEP[i]
+			    && m_pEP[i]->GetDirection () == (  bIn ? CDWUSBGadgetEndpoint::DirectionIn
+							      : CDWUSBGadgetEndpoint::DirectionOut))
+			{
+				m_pEP[i]->HandleIncompleteIso (nFrame);
+			}
+		}
+	}
+
+	CDWHCIRegister IntStatus (DWHCI_CORE_INT_STAT,   bIn ? DWHCI_CORE_INT_MASK_INCOMPL_ISO_IN
+							 : DWHCI_CORE_INT_MASK_INCOMPL_ISO_OUT);
+	IntStatus.Write ();
+}
+
+void CDWUSBGadget::CountIsoPending (int nDelta)
+{
+	boolean bWasOn = m_nIsoPending > 0;
+	m_nIsoPending += nDelta;
+	if (m_nIsoPending < 0)
+	{
+		m_nIsoPending = 0;
+	}
+	boolean bOn = m_nIsoPending > 0;
+	if (bOn == bWasOn)
+	{
+		return;
+	}
+
+	CDWHCIRegister OutEPCommonIntMask (DWHCI_DEV_OUT_EP_COMMON_INT_MASK);
+	OutEPCommonIntMask.Read ();
+	CDWHCIRegister InEPCommonIntMask (DWHCI_DEV_IN_EP_COMMON_INT_MASK);
+	InEPCommonIntMask.Read ();
+	if (bOn)
+	{
+		OutEPCommonIntMask.Or (DWHCI_DEV_OUT_EP_INT_OUT_TOKEN_EP_DISABLED);
+		InEPCommonIntMask.Or (DWHCI_DEV_IN_EP_INT_NAK);
+	}
+	else
+	{
+		OutEPCommonIntMask.And (~DWHCI_DEV_OUT_EP_INT_OUT_TOKEN_EP_DISABLED);
+		InEPCommonIntMask.And (~DWHCI_DEV_IN_EP_INT_NAK);
+	}
+	OutEPCommonIntMask.Write ();
+	InEPCommonIntMask.Write ();
+}
