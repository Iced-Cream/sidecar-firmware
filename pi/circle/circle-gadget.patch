+// Programs the stored isochronous transfer for m_nTargetFrame: one packet, the target's frame parity.
+void CDWUSBGadgetEndpoint::ArmIso (void)
+{
+	void *pBuffer = m_nTransferLength ? m_pTransferBuffer : m_DummyBuffer;
+	u32 nParity = m_nTargetFrame & 1 ? DWHCI_DEV_EP_CTRL_SETDPID_D1		// SetOddFr
+					 : DWHCI_DEV_EP_CTRL_SETDPID_D0;	// SetEvenFr
+	if (m_Direction == DirectionIn)
+	{
+		CDWHCIRegister InEPXferSize (DWHCI_DEV_IN_EP_XFER_SIZ (m_nEP), 0);
+		InEPXferSize.Or (1 << DWHCI_DEV_EP_XFER_SIZ_PKT_CNT__SHIFT);
+		InEPXferSize.Or (m_nTransferLength << DWHCI_DEV_EP_XFER_SIZ_XFER_SIZ__SHIFT);
+		InEPXferSize.Or (1 << DWHCI_DEV_EP_XFER_SIZ_MULTI_CNT__SHIFT);	// one packet per (micro)frame
+		InEPXferSize.Write ();
+
+		CDWHCIRegister InEPDMAAddress (DWHCI_DEV_IN_EP_DMA_ADDR (m_nEP), BUS_ADDRESS ((uintptr) pBuffer));
+		InEPDMAAddress.Write ();
+
+		CDWHCIRegister InEPCtrl (DWHCI_DEV_IN_EP_CTRL (m_nEP));
+		InEPCtrl.Read ();
+		InEPCtrl.Or (nParity | DWHCI_DEV_EP_CTRL_EP_ENABLE | DWHCI_DEV_EP_CTRL_CLEAR_NAK);
+		InEPCtrl.Write ();
+	}
+	else
+	{
+		CDWHCIRegister OutEPXferSize (DWHCI_DEV_OUT_EP_XFER_SIZ (m_nEP), 0);
+		OutEPXferSize.Or (1 << DWHCI_DEV_EP_XFER_SIZ_PKT_CNT__SHIFT);
+		OutEPXferSize.Or (m_nTransferLength << DWHCI_DEV_EP_XFER_SIZ_XFER_SIZ__SHIFT);
+		OutEPXferSize.Write ();
+
+		CDWHCIRegister OutEPDMAAddress (DWHCI_DEV_OUT_EP_DMA_ADDR (m_nEP), BUS_ADDRESS ((uintptr) pBuffer));
+		OutEPDMAAddress.Write ();
+
+		CDWHCIRegister OutEPCtrl (DWHCI_DEV_OUT_EP_CTRL (m_nEP));
+		OutEPCtrl.Read ();
+		OutEPCtrl.Or (nParity | DWHCI_DEV_EP_CTRL_EP_ENABLE | DWHCI_DEV_EP_CTRL_CLEAR_NAK);
+		OutEPCtrl.Write ();
+	}
+}
+
+void CDWUSBGadgetEndpoint::SetIsoPending (boolean bPending)
+{
+	if (m_bIsoPending == bPending)
+	{
+		return;
+	}
+
+	m_bIsoPending = bPending;
+
+	assert (m_pGadget);
+	m_pGadget->CountIsoPending (bPending ? 1 : -1);
+}
+
+// A token for this EP while it was not enabled (OUT: OUT token received when EP disabled; IN: NAK): the host
+// serves it in this (micro)frame, so a pending transfer is armed for one interval later (as the Linux dwc2 driver
+// does in buffer DMA mode).
+void CDWUSBGadgetEndpoint::HandleIsoToken (void)
+{
+	if (m_Type != TypeIsochronous || !m_bIsoPending)
+	{
+		return;
+	}
+
+	SetIsoPending (FALSE);
+	m_nTargetFrame = (GetFrameNumber () + m_nInterval) & 0x3FFF;
+	ArmIso ();
+}
+
+unsigned CDWUSBGadgetEndpoint::GetFrameNumber (void)
+{
+	CDWHCIRegister DeviceStatus (DWHCI_DEV_STS);
+
+	return (DeviceStatus.Read () >> 8) & 0x3FFF;		// SOFFN
+}
+
+// IRQ level. Disables this EP (when enabled) and waits until the core has done so (a few microseconds); the
+// transfer is not finished here. IN: its TX FIFO is flushed.
+void CDWUSBGadgetEndpoint::DisableEndpoint (void)
+{
+	if (m_Direction == DirectionIn)
+	{
+		CDWHCIRegister InEPCtrl (DWHCI_DEV_IN_EP_CTRL (m_nEP));
+		if (InEPCtrl.Read () & DWHCI_DEV_EP_CTRL_EP_ENABLE)
+		{
+			InEPCtrl.And (~(  DWHCI_DEV_EP_CTRL_CLEAR_NAK | DWHCI_DEV_EP_CTRL_SETDPID_D0
+					| DWHCI_DEV_EP_CTRL_SETDPID_D1));
+			InEPCtrl.Or (DWHCI_DEV_EP_CTRL_SET_NAK | DWHCI_DEV_EP_CTRL_EP_DISABLE);
+			InEPCtrl.Write ();
+
+			CDWHCIRegister InEPInt (DWHCI_DEV_IN_EP_INT (m_nEP));
+			for (unsigned i = 0; i < 5000 && !(InEPInt.Read () & DWHCI_DEV_IN_EP_INT_EP_DISABLED); i++)
+			{
+			}
+		}
+
+		CDWHCIRegister InEPIntAck (DWHCI_DEV_IN_EP_INT (m_nEP),   DWHCI_DEV_IN_EP_INT_EP_DISABLED
+									| DWHCI_DEV_IN_EP_INT_XFER_COMPLETE);
+		InEPIntAck.Write ();
+
+		// its TX FIFO flushed, polled here: CDWUSBGadget::FlushTxFIFO waits in 1 ms steps (MsDelay), which at IRQ
+		// level stalled core 0's other interrupts for 1 ms (measured: the xHCI host lost Overbridge blocks)
+		CDWHCIRegister Reset (DWHCI_CORE_RESET, 0);
+		Reset.Or (DWHCI_CORE_RESET_TX_FIFO_FLUSH);
+		Reset.Or (m_nEP << DWHCI_CORE_RESET_TX_FIFO_NUM__SHIFT);
+		Reset.Write ();
+		for (unsigned i = 0; i < 5000 && (Reset.Read () & DWHCI_CORE_RESET_TX_FIFO_FLUSH); i++)
+		{
+		}
+		CTimer::SimpleusDelay (1);		// 3 PHY clocks
+	}
+	else
+	{
+		CDWHCIRegister OutEPCtrl (DWHCI_DEV_OUT_EP_CTRL (m_nEP));
+		if (OutEPCtrl.Read () & DWHCI_DEV_EP_CTRL_EP_ENABLE)
+		{
+			// an OUT EP is disabled under the global OUT NAK
+			CDWHCIRegister DeviceCtrl (DWHCI_DEV_CTRL);
+			DeviceCtrl.Read ();
+			DeviceCtrl.Or (DWHCI_DEV_CTRL_SET_GLOBAL_OUT_NAK);
+			DeviceCtrl.Write ();
+
+			CDWHCIRegister IntStatus (DWHCI_CORE_INT_STAT);
+			for (unsigned i = 0;    i < 5000
+					     && !(IntStatus.Read () & DWHCI_CORE_INT_STAT_GLOBAL_OUT_NAK_EFF); i++)
+			{
+			}
+
+			OutEPCtrl.Read ();
+			OutEPCtrl.And (~(  DWHCI_DEV_EP_CTRL_CLEAR_NAK | DWHCI_DEV_EP_CTRL_SETDPID_D0
+					 | DWHCI_DEV_EP_CTRL_SETDPID_D1));
+			OutEPCtrl.Or (DWHCI_DEV_EP_CTRL_SET_NAK | DWHCI_DEV_EP_CTRL_EP_DISABLE);
+			OutEPCtrl.Write ();
+
+			CDWHCIRegister OutEPInt (DWHCI_DEV_OUT_EP_INT (m_nEP));
+			for (unsigned i = 0; i < 5000 && !(OutEPInt.Read () & DWHCI_DEV_OUT_EP_INT_EP_DISABLED); i++)
+			{
+			}
+
+			DeviceCtrl.Read ();
+			DeviceCtrl.And (~DWHCI_DEV_CTRL_SET_GLOBAL_OUT_NAK);
+			DeviceCtrl.Or (DWHCI_DEV_CTRL_CLEAR_GLOBAL_OUT_NAK);
+			DeviceCtrl.Write ();
+
+			CDWHCIRegister IntStatusAck (DWHCI_CORE_INT_STAT, DWHCI_CORE_INT_STAT_GLOBAL_OUT_NAK_EFF);
+			IntStatusAck.Write ();
+		}
+
+		CDWHCIRegister OutEPIntAck (DWHCI_DEV_OUT_EP_INT (m_nEP),   DWHCI_DEV_OUT_EP_INT_EP_DISABLED
+									  | DWHCI_DEV_OUT_EP_INT_XFER_COMPLETE);
+		OutEPIntAck.Write ();
+	}
+}
+
+void CDWUSBGadgetEndpoint::StopIsoTransfer (void)
+{
+	assert (m_Type == TypeIsochronous);
+
+	DisableEndpoint ();
+
+	SetIsoPending (FALSE);
+	InitTransfer ();
+	m_bIsoContinue = FALSE;
+}
+
+void CDWUSBGadgetEndpoint::HandleIncompleteIso (unsigned nFrame)
+{
+	if (m_Type != TypeIsochronous || !IsTransferActive () || m_bIsoPending)
+	{
+		return;
+	}
+
+	CDWHCIRegister EPCtrl (  m_Direction == DirectionIn
+			       ? DWHCI_DEV_IN_EP_CTRL (m_nEP)
+			       : DWHCI_DEV_OUT_EP_CTRL (m_nEP));
+	if (   !(EPCtrl.Read () & DWHCI_DEV_EP_CTRL_EP_ENABLE)
+	    || ((nFrame - m_nTargetFrame) & 0x3FFF) >= 0x2000)	// its target is still to come: not missed
+	{
+		return;
+	}
+
+	// missed: disabled, and armed again at the host's next token (the same buffer)
+	DisableEndpoint ();
+	m_nIsoIncomplete++;
+	SetIsoPending (TRUE);
+}
