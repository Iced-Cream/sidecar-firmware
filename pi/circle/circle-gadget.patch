 	CDWUSBGadget *pThis = static_cast<CDWUSBGadget *> (pParam);
 	assert (pThis != 0);
 
+	u64 t0, t1;
+	asm volatile ("isb; mrs %0, cntpct_el0" : "=r" (t0));
 	pThis->InterruptHandler ();
+	asm volatile ("isb; mrs %0, cntpct_el0" : "=r" (t1));
+	pThis->m_nIRQs++;
+	pThis->m_nIRQTicks += t1 - t0;
+	if (pThis->m_nLastEntry != 0)
+	{
+		u64 nGap = t0 - pThis->m_nLastEntry;
+		if (nGap > pThis->m_nMaxGap) pThis->m_nMaxGap = nGap;
+		if (nGap > pThis->m_nLongTicks) pThis->m_nLongGaps++;
+	}
+	pThis->m_nLastEntry = t0;
+	if (t1 - t0 > pThis->m_nMaxHandler) pThis->m_nMaxHandler = t1 - t0;
