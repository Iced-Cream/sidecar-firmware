#!/bin/sh
# Start the engine after S10rt-tune: audio thread SCHED_FIFO 80 on core 3 (set by the engine itself).
case "$1" in
  start) echo "engine: starting"; start-stop-daemon -S -b -m -p /var/run/engine.pid -x /usr/bin/engine -- --seconds 31536000 ;;
  stop) start-stop-daemon -K -p /var/run/engine.pid ;;
  *) echo "usage: $0 start|stop"; exit 1 ;;
esac
