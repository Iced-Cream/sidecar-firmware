# PREEMPT_RT is mainline since 6.12 (arm64 ARCH_SUPPORTS_RT); bcm2711_defconfig has CONFIG_PREEMPT=y, so switch it.
CONFIG_EXPERT=y
# CONFIG_PREEMPT is not set
CONFIG_PREEMPT_RT=y
CONFIG_HZ_1000=y
CONFIG_NO_HZ_FULL=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND is not set
