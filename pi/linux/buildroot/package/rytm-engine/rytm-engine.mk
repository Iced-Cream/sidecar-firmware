RYTM_ENGINE_VERSION = 1.0
RYTM_ENGINE_SITE = $(BR2_EXTERNAL_RYTM_PATH)/../engine
RYTM_ENGINE_SITE_METHOD = local
RYTM_ENGINE_DEPENDENCIES = libusb host-pkgconf

define RYTM_ENGINE_BUILD_CMDS
	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) CC="$(TARGET_CC)" CFLAGS="$(TARGET_CFLAGS)" \
		LDFLAGS="$(TARGET_LDFLAGS)" PKG_CONFIG="$(PKG_CONFIG_HOST_BINARY)" \
		PKG_CONFIG_PATH="$(STAGING_DIR)/usr/lib/pkgconfig" PKG_CONFIG_SYSROOT_DIR="$(STAGING_DIR)"
endef

define RYTM_ENGINE_INSTALL_TARGET_CMDS
	$(INSTALL) -D -m 0755 $(@D)/engine $(TARGET_DIR)/usr/bin/engine
endef

$(eval $(generic-package))
